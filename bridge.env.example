# Template only. Copy to bridge.env (ignored by Git), then edit locally.
# Prefer the complete config generated by: virtuoso-bridge init user@vm-host
VB_REMOTE_HOST=your-vm-host
VB_REMOTE_USER=your-vm-user
VB_REMOTE_PORT=65118
VB_LOCAL_PORT=18765
# SSH must work without an interactive password prompt.
# Keep SSH identity/config and bridge authentication outside the repository.
# Optional; use an existing writable absolute directory on the remote host:
# VB_REMOTE_SCRATCH_ROOT=/home/your-vm-user/.virtuoso-bridge
# Optional when Spectre is not on the remote login shell PATH:
# VB_SPECTRE_BIN=/path/to/spectre
# VB_CADENCE_CSHRC=/path/to/cadence-env.sh
# VB_CADENCE_ENV_SHELL=sh
